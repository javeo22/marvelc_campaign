{
  "name": "core-protocol-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first fan companion for the Core Protocol campaign.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:images": "tsx scripts/assert-no-card-images.ts",
    "cloud:migrate": "tsx scripts/cloud-database.ts --migrate",
    "cloud:check": "tsx scripts/cloud-database.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "idb": "8.0.3",
    "lucide-react": "1.43.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
