{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Core Protocol Comic UI",
    "principle": "Comic-book energy with table-first legibility; original graphic language, no copied logos, card frames, or Marvel artwork."
  },
  "color": {
    "ink": {
      "value": "#101318",
      "type": "color"
    },
    "navy": {
      "value": "#0C1F3D",
      "type": "color"
    },
    "crimson": {
      "value": "#C91F3A",
      "type": "color"
    },
    "gold": {
      "value": "#E2B341",
      "type": "color"
    },
    "paper": {
      "value": "#F7F1E4",
      "type": "color"
    },
    "paperElevated": {
      "value": "#FFFDF7",
      "type": "color"
    },
    "sky": {
      "value": "#DCEAF4",
      "type": "color"
    },
    "success": {
      "value": "#2E6B4E",
      "type": "color"
    },
    "warning": {
      "value": "#A95316",
      "type": "color"
    },
    "danger": {
      "value": "#A61E2D",
      "type": "color"
    },
    "mutedInk": {
      "value": "#5B606A",
      "type": "color"
    }
  },
  "font": {
    "display": {
      "value": "Bangers, Impact, sans-serif",
      "type": "fontFamily"
    },
    "ui": {
      "value": "Atkinson Hyperlegible, Source Sans 3, system-ui, sans-serif",
      "type": "fontFamily"
    },
    "narrative": {
      "value": "Roboto Slab, Noto Serif, Georgia, serif",
      "type": "fontFamily"
    },
    "mono": {
      "value": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "type": "fontFamily"
    }
  },
  "border": {
    "panelWidth": {
      "value": "3px",
      "type": "dimension"
    },
    "heavyWidth": {
      "value": "5px",
      "type": "dimension"
    },
    "radiusSm": {
      "value": "4px",
      "type": "dimension"
    },
    "radiusMd": {
      "value": "8px",
      "type": "dimension"
    }
  },
  "shadow": {
    "panel": {
      "value": "4px 4px 0 #101318",
      "type": "shadow"
    },
    "pressed": {
      "value": "1px 1px 0 #101318",
      "type": "shadow"
    }
  },
  "space": {
    "1": {
      "value": "0.25rem",
      "type": "dimension"
    },
    "2": {
      "value": "0.5rem",
      "type": "dimension"
    },
    "3": {
      "value": "0.75rem",
      "type": "dimension"
    },
    "4": {
      "value": "1rem",
      "type": "dimension"
    },
    "6": {
      "value": "1.5rem",
      "type": "dimension"
    },
    "8": {
      "value": "2rem",
      "type": "dimension"
    },
    "12": {
      "value": "3rem",
      "type": "dimension"
    }
  },
  "motion": {
    "fast": {
      "value": "120ms",
      "type": "duration"
    },
    "panel": {
      "value": "200ms",
      "type": "duration"
    },
    "easing": {
      "value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "type": "cubicBezier"
    },
    "reducedMotionRule": {
      "value": "Disable transforms, shakes, parallax, and page-turn effects when prefers-reduced-motion is set.",
      "type": "string"
    }
  },
  "touch": {
    "minimumTarget": {
      "value": "44px",
      "type": "dimension"
    },
    "tableModeTarget": {
      "value": "52px",
      "type": "dimension"
    }
  }
}
